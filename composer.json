{
    "name": "laravel-chronicle/core",
    "description": "Tamper-evident audit ledger for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "audit log",
        "audit trail",
        "append-only log",
        "event log",
        "ledger",
        "security",
        "hash chain",
        "compliance",
        "chronicle"
    ],
    "homepage": "https://github.com/laravel-chronicle/core",
    "support": {
        "issues": "https://github.com/laravel-chronicle/core/issues"
    },
    "authors": [
        {
            "name": "Vasileios Ntoufoudis",
            "email": "info@ntoufoudis.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0||^13.0",
        "ext-sodium": "*",
        "ext-openssl": "*",
        "symfony/process": "^7.0||^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^3.0||^4.0",
        "pestphp/pest-plugin-laravel": "^3.0||^4.0"
    },
    "autoload": {
        "psr-4": {
            "Chronicle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chronicle\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chronicle\\ChronicleServiceProvider"
            ],
            "aliases": {
                "chronicle": "Chronicle\\Facades\\Chronicle"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": "vendor/bin/pint",
        "test:lint": "vendor/bin/pint --test -v",
        "test:types": "vendor/bin/phpstan analyse",
        "test:unit": "vendor/bin/pest",
        "test:parallel": "vendor/bin/pest --parallel",
        "test:coverage": "vendor/bin/pest --parallel --coverage",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:parallel"
        ]
    }
}
